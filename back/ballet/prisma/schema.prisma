generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model escola {
  id            Int      @id @default(autoincrement())
  nomeEscola    String
  responsavel   String
  email         String
  telefone      String
  taxaRoylties  Decimal  @db.Decimal(12, 5)
  diaPagamento  Int
  cidade        String
  uf            String
  bairro        String
  cep           String
  usuarios      usuarios[]
}

model usuarios {
  id                  Int      @id @default(autoincrement())
  email               String   @unique
  senha               String
  nome                String
  senhaTemporaria     Boolean  @default(true)
  idEscola            Int?
  escola              escola?   @relation(fields: [idEscola], references: [id])
  createdAt           DateTime @default(now())
}